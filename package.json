{
  "name": "tick",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "branding:verify": "node scripts/verify-app-branding.mjs Tick",
    "dev": "vite",
    "build": "npm run branding:verify && tsc && vite build",
    "check": "npm run version:verify && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked && npm run test:path-privacy && npm run build",
    "build:windows": "node scripts/build-windows.mjs",
    "test:path-privacy": "node --test scripts/scan-binary-paths.test.mjs",
    "version:verify": "node scripts/verify-version.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@uiw/react-codemirror": "^4.25.9",
    "antd": "^6.3.7",
    "dayjs": "^1.11.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
